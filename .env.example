# MarCRM environment variables
# Copy to .env and fill in. .env is gitignored — never commit real values.
# These must also be set in the Vercel project settings for the deployed app.

# ---- REQUIRED ----

# Neon PostgreSQL connection string.
# Neon dashboard → your project → Connection Details → copy the pooled connection string.
# Must include ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Brave Search API — free, 2,000 queries/month, no card required.
# https://brave.com/search/api/ → Get started → Free plan
# Required for Reddit and social scraping. Scrapes degrade badly without it.
BRAVE_SEARCH_API_KEY=

# ---- OPTIONAL ----

# Hunter.io — contact email enrichment. Free tier: 50 searches/month, no card.
# https://hunter.io → Settings → API
# Usage is tracked in the EnrichmentLog table against the monthly limit.
HUNTER_API_KEY=

# RocketReach — contact enrichment, paid.
# https://rocketreach.co/api → Settings
# ROCKETREACH_API_KEY=

# ---- NOT IN USE ----
# Placeholders from the original build. Nothing in the codebase requires them.
# PROXYCURL_API_KEY=      # LinkedIn enrichment, https://proxycurl.com
# CRUNCHBASE_API_KEY=     # funding data, https://data.crunchbase.com/docs
# CLEARBIT_API_KEY=       # company enrichment, https://clearbit.com
